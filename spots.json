async function fetchJson(path) {
  const res = await fetch(path, { cache: "no-store" });
  if (!res.ok) throw new Error(`Failed to load ${path}`);
  return res.json();
}

function escapeHtml(value) {
  return String(value ?? "").replace(/[&<>"']/g, (m) => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;"
  }[m]));
}

function card(title, rows, links = []) {
  const meta = rows.map(([k, v, type]) => `<span class="tag ${type || ""}">${escapeHtml(k)}：${escapeHtml(v || "要確認")}</span>`).join("");
  const linkHtml = links.filter(l => l.url).map(l => `<a class="button" href="${escapeHtml(l.url)}" target="_blank" rel="noopener">${escapeHtml(l.label)}</a>`).join(" ");
  return `<article class="info-card">
    <h3>${escapeHtml(title)}</h3>
    <div class="meta">${meta}</div>
    <div class="links">${linkHtml}</div>
  </article>`;
}

async function renderFeaturedSpots() {
  const el = document.getElementById("featured-spots");
  if (!el) return;
  const spots = await fetchJson("data/spots.json");
  el.innerHTML = spots.slice(0, 3).map(s => card(s.name, [
    ["エリア", s.area],
    ["ジャンル", s.type],
    ["大型犬", s.largeDog, "warn"],
    ["最終確認日", s.lastChecked],
    ["状態", s.status]
  ], [{ label: "公式情報を見る", url: s.officialUrl }])).join("");
}

async function renderSpots() {
  const el = document.getElementById("spots-list");
  if (!el) return;
  const spots = await fetchJson("data/spots.json");
  const areaFilter = document.getElementById("area-filter");
  const typeFilter = document.getElementById("type-filter");

  [...new Set(spots.map(s => s.area))].forEach(a => areaFilter.innerHTML += `<option value="${escapeHtml(a)}">${escapeHtml(a)}</option>`);
  [...new Set(spots.map(s => s.type))].forEach(t => typeFilter.innerHTML += `<option value="${escapeHtml(t)}">${escapeHtml(t)}</option>`);

  const draw = () => {
    const area = areaFilter.value, type = typeFilter.value;
    el.innerHTML = spots.filter(s => (!area || s.area === area) && (!type || s.type === type)).map(s => card(s.name, [
      ["エリア", s.area],
      ["ジャンル", s.type],
      ["犬同伴", s.dogAllowed, "warn"],
      ["大型犬", s.largeDog, "warn"],
      ["駐車場", s.parking],
      ["最終確認日", s.lastChecked],
      ["状態", s.status]
    ], [
      { label: "公式情報", url: s.officialUrl },
      { label: "参照元", url: s.sourceUrl }
    ])).join("");
  };
  areaFilter.addEventListener("change", draw);
  typeFilter.addEventListener("change", draw);
  draw();
}

async function renderHotels() {
  const el = document.getElementById("hotels-list");
  if (!el) return;
  const hotels = await fetchJson("data/hotels.json");
  el.innerHTML = hotels.map(h => {
    const search = h.searchKeyword ? `<p class="search-keyword">検索ワード例：<strong>${escapeHtml(h.searchKeyword)}</strong></p>` : "";
    return `<article class="info-card hotel-card">
      <h3>${escapeHtml(h.name)}</h3>
      <p class="notice">犬同伴条件・料金・頭数制限・ワクチン証明の有無は変更される場合があります。予約前に必ず公式情報をご確認ください。</p>
      ${search}
      <div class="meta">
        <span class="tag">エリア：${escapeHtml(h.area)}</span>
        <span class="tag warn">犬サイズ：${escapeHtml(h.dogSize)}</span>
        <span class="tag warn">客室同伴：${escapeHtml(h.roomWithDog)}</span>
        <span class="tag warn">ワクチン証明：${escapeHtml(h.vaccineRequired)}</span>
        <span class="tag">最終確認日：${escapeHtml(h.lastChecked)}</span>
        <span class="tag">${escapeHtml(h.status)}</span>
      </div>
      <a class="button primary" href="${escapeHtml(h.rakutenTravelUrl || h.officialUrl)}" target="_blank" rel="noopener">楽天トラベルを開く</a>
    </article>`;
  }).join("");
}

async function renderEvents() {
  const el = document.getElementById("events-list");
  if (!el) return;
  const events = await fetchJson("data/events.json");
  el.innerHTML = events.map(ev => card(ev.name, [
    ["開催日", ev.date, "warn"],
    ["エリア", ev.area],
    ["会場", ev.venue, "warn"],
    ["犬同伴ルール", ev.dogRules, "warn"],
    ["最終確認日", ev.lastChecked],
    ["状態", ev.status]
  ], [
    { label: "公式サイト", url: ev.officialUrl },
    { label: "公式SNS", url: ev.officialSnsUrl }
  ])).join("");
}

function productCard(p) {
  const imageUrl = Array.isArray(p.mediumImageUrls) && p.mediumImageUrls.length ? p.mediumImageUrls[0] : "";
  const img = imageUrl
    ? `<img class="product-img" src="${escapeHtml(imageUrl)}" alt="${escapeHtml(p.productName)}">`
    : `<div class="product-placeholder">🐾</div>`;

  const url = p.rakutenAffiliateUrl || p.normalUrl || "";
  const price = p.itemPrice ? `<span class="tag">価格目安：${escapeHtml(p.itemPrice)}円</span>` : "";
  const rating = p.rating ? `<span class="tag">評価：${escapeHtml(p.rating)}</span>` : "";
  const reviews = p.reviewCount ? `<span class="tag">レビュー：${escapeHtml(p.reviewCount)}件</span>` : "";
  const shop = p.shopName ? `<span class="tag">ショップ：${escapeHtml(p.shopName)}</span>` : "";

  return `<article class="info-card product-card">
    ${img}
    <div class="product-body">
      <p class="tag">${escapeHtml(p.category || "犬用品")}</p>
      <h3>${escapeHtml(p.productName)}</h3>
      <p>${escapeHtml(p.whyCandidate || "犬連れおでかけに便利な候補です。")}</p>
      <div class="meta">
        ${price}
        ${rating}
        ${reviews}
        ${shop}
        <span class="tag warn">最終確認日：${escapeHtml(p.lastChecked || "未取得")}</span>
      </div>
      ${url ? `<a class="button primary" href="${escapeHtml(url)}" target="_blank" rel="noopener">楽天で見る</a>` : `<span class="tag warn">楽天API更新後にリンク表示</span>`}
    </div>
  </article>`;
}

async function renderProducts() {
  const el = document.getElementById("products-list");
  if (!el) return;
  const products = await fetchJson("data/products.json");
  el.innerHTML = products.map(productCard).join("");
}

async function renderProductBanners() {
  const el = document.getElementById("product-banners");
  if (!el) return;
  const products = await fetchJson("data/products.json");
  el.innerHTML = products.slice(0, 8).map(productCard).join("");
}

document.addEventListener("DOMContentLoaded", () => {
  renderFeaturedSpots().catch(console.error);
  renderSpots().catch(console.error);
  renderHotels().catch(console.error);
  renderEvents().catch(console.error);
  renderProducts().catch(console.error);
  renderProductBanners().catch(console.error);
});
