const STORAGE_KEY="daisy_diagnosis_preferences";const productRules=[{name:"車用シートカバー",dogSize:["中型犬","大型犬"],scenes:["車移動"],concerns:["抜け毛","車内の汚れ"]},{name:"大型犬用ハーネス",dogSize:["大型犬"],scenes:["車移動","ドッグラン","イベント"],concerns:["安全対策"]},{name:"携帯水飲みボトル",dogSize:["小型犬","中型犬","大型犬"],scenes:["宿泊旅行","イベント","ドッグラン","カフェ"],concerns:["暑さ寒さ"]},{name:"犬用レインコート",dogSize:["中型犬","大型犬"],scenes:["雨の日"],concerns:["雨対策"]},{name:"マナー袋・消臭袋",dogSize:["小型犬","中型犬","大型犬"],scenes:["宿泊旅行","イベント","カフェ"],concerns:["マナー対策"]},{name:"抜け毛対策ブラシ",dogSize:["中型犬","大型犬"],scenes:["宿泊旅行","車移動"],concerns:["抜け毛"]},{name:"折りたたみフードボウル",dogSize:["小型犬","中型犬","大型犬"],scenes:["宿泊旅行","イベント"],concerns:["荷物が多い"]},{name:"吸水タオル",dogSize:["小型犬","中型犬","大型犬"],scenes:["雨の日","車移動"],concerns:["雨対策","車内の汚れ"]}];function savePrefs(prefs){localStorage.setItem(STORAGE_KEY,JSON.stringify(prefs))}function loadPrefs(){try{return JSON.parse(localStorage.getItem(STORAGE_KEY))||{}}catch{return{}}}function recommend({dogSize,scene,concern}){const scored=productRules.map(p=>{let score=0;if(p.dogSize.includes(dogSize))score+=2;if(p.scenes.includes(scene))score+=2;if(p.concerns.includes(concern))score+=2;return{...p,score}}).filter(p=>p.score>0).sort((a,b)=>b.score-a.score).slice(0,5);return scored.length?scored:productRules.slice(0,5)}function renderDiagnosis(){const root=document.getElementById("diagnosis-widget");if(!root)return;const prefs={dogSize:"大型犬",scene:"車移動",concern:"抜け毛",...loadPrefs()};root.innerHTML=`<div class="diagnosis-box"><div class="diagnosis-grid"><label>わんちゃんのサイズ<select id="dog-size">${["小型犬","中型犬","大型犬"].map(v=>`<option ${prefs.dogSize===v?"selected":""}>${v}</option>`).join("")}</select></label><label>よく行くおでかけ<select id="scene">${["車移動","宿泊旅行","雨の日","ドッグラン","カフェ","イベント"].map(v=>`<option ${prefs.scene===v?"selected":""}>${v}</option>`).join("")}</select></label><label>気になること<select id="concern">${["抜け毛","車内の汚れ","雨対策","荷物が多い","マナー対策","暑さ寒さ","安全対策"].map(v=>`<option ${prefs.concern===v?"selected":""}>${v}</option>`).join("")}</select></label></div><div id="diagnosis-result" class="result-card"></div><p class="small">この診断はブラウザ内に好み設定を保存する場合があります。個人を特定する目的では利用しません。</p></div>`;const draw=()=>{const current={dogSize:document.getElementById("dog-size").value,scene:document.getElementById("scene").value,concern:document.getElementById("concern").value};savePrefs(current);const items=recommend(current).map(p=>`<li>${p.name}</li>`).join("");document.getElementById("diagnosis-result").innerHTML=`<strong>Daisyおすすめ候補</strong><ul>${items}</ul><p class="small">価格・在庫・評価は変動します。購入前にリンク先で最新情報を確認してください。</p>`};["dog-size","scene","concern"].forEach(id=>document.getElementById(id).addEventListener("change",draw));draw()}document.addEventListener("DOMContentLoaded",renderDiagnosis)
